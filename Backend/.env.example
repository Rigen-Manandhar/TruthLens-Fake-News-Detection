# Copy to .env in Backend/ if you want to override model locations.
# Leave blank to use defaults under Backend/model/model_a and model_b.

HEADLINE_MODEL_PATH=
ARTICLE_MODEL_PATH=
BACKEND_CORS_ORIGINS=

# Optional. Enables lightweight trusted-source coverage checks in evidence_summary.
# If blank, predictions still work and coverage_signal reports NOT_CONFIGURED.
NEWS_API_KEY=
